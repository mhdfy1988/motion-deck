{
  "name": "motion-deck",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {"node": ">=24.0.0"},
  "description": "MotionDeck：3D 动作与姿势编排、参考录制及模型导出工具",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-motion-lab.mjs",
    "build:experiment": "node scripts/build-fullbody-trial.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "dev": "node scripts/serve-motion-lab.mjs",
    "start": "node scripts/serve-motion-lab.mjs",
    "test": "node --test tests/web/*.test.mjs",
    "test:e2e": "playwright test --config playwright.config.js",
    "assets:verify": "node scripts/verify-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "closed-chain-ik": "https://codeload.github.com/gkjohnson/closed-chain-ik-js/tar.gz/1132da3dc3ac774426e9af503e4915bc04ca413b",
    "esbuild": "0.25.12",
    "lucide-static": "1.52.0",
    "three": "0.186.1"
  }
}
